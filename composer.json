{
    "name": "bayurifkialghifari/dynamic-qris-php-client",
    "description": "Laravel client with typed DTOs for the Dynamic QRIS ShopeePay and GoPay gateway",
    "homepage": "https://github.com/bayurifkialghifari/dynamic-qris-php-client",
    "license": "MIT",
    "keywords": [
        "laravel",
        "qris",
        "shopeepay",
        "gopay",
        "sdk"
    ],
    "authors": [
        {
            "name": "Bayu Rifki Alghifari"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Bayurifkialghifari\\DynamicQris\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bayurifkialghifari\\DynamicQris\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "format": "@php vendor/bin/pint",
        "format:check": "@php vendor/bin/pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bayurifkialghifari\\DynamicQris\\DynamicQrisServiceProvider"
            ],
            "aliases": {
                "DynamicQris": "Bayurifkialghifari\\DynamicQris\\Facades\\DynamicQris"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true
}
